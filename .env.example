# Supabase → Project Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Any long random string (signs staff login cookies)
SESSION_SECRET=

# PayMongo dashboard → Developers → API keys (use the TEST key: sk_test_...)
PAYMONGO_SECRET_KEY=
# Optional: only needed once deployed and a webhook is registered
PAYMONGO_WEBHOOK_SECRET=

# Optional: leave empty to keep SMS in the demo outbox
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER=

# Vercel sets this for cron requests; set the same value in Vercel env vars
CRON_SECRET=
